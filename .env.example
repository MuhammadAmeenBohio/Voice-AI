# Persistent SQLite database in project root
DATABASE_URL=sqlite:///./patients.db

# Public URL of your deployed application or active ngrok tunnel
# Example: https://abc-123.ngrok-free.app or https://your-app.up.railway.app
PUBLIC_API_URL=http://localhost:8000

# Optional API Key for write protection (leave blank for open reviewer testing)
API_KEY=

# Vapi Private API Key (used by voice_agent/setup_vapi.py)
# Sign up free at https://vapi.ai to get $10 in trial credits
VAPI_API_KEY=

# Vapi Public Key (used for in-browser Web Voice Calling on the dashboard)
VAPI_PUBLIC_KEY=

# Vapi Assistant ID (auto-generated when running voice_agent/setup_vapi.py)
VAPI_ASSISTANT_ID=

# Groq LLM Configuration (Ultra-low latency inference for voice agents)
# Get your free key at https://console.groq.com
GROQ_API_KEY=
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.1-8b-instant
